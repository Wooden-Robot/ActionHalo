<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ActionHalo" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#FFA16B</item>
        <item name="android:windowBackground">#101319</item>
        <item name="android:statusBarColor">#101319</item>
        <item name="android:navigationBarColor">#101319</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.ActionHalo.Halo" parent="Theme.ActionHalo">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
